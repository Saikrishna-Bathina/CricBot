# ==============================================================================
# CricBot Python FastAPI RAG Service Environment Configuration (.env.example)
# ==============================================================================

PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO

# CORS Allowed Origins (Comma-separated list of origins, or * for internal networking)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://cricbot-api.onrender.com

# MongoDB Atlas URI & Database Name
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cricket_laws?retryWrites=true&w=majority
MONGODB_DB_NAME=cricket_laws

# AI LLM Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# Embeddings & Vector Search Settings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768
VECTOR_INDEX_NAME=cricket_vector_index
