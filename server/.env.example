# ==============================================================================
# CricBot Express Backend Environment Configuration (.env.example)
# ==============================================================================

# Server Runtime Environment
NODE_ENV=production
PORT=5000

# CORS & Allowed Frontend Origins
# Single URL or comma-separated list of allowed web domains
CLIENT_URL=https://cricbot.vercel.app
ALLOWED_ORIGINS=https://cricbot.vercel.app,http://localhost:5173

# MongoDB Atlas Database URI (Do not use localhost in production)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/cricket_laws?retryWrites=true&w=majority

# Authentication & Security
# Mandatory: In production, generate a secure random 32+ character key (e.g. openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_32_character_string_for_production
JWT_EXPIRES_IN=7d

# Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=10

# AI Generation Provider (gemini | openai | mock)
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# Embeddings & Vector Search (gemini | openai | local)
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768
VECTOR_INDEX_NAME=cricket_vector_index

# File Storage Configuration
UPLOAD_STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# Python FastAPI RAG Microservice Integration
USE_PYTHON_RAG=true
PYTHON_RAG_SERVICE_URL=http://127.0.0.1:8000
PYTHON_RAG_TIMEOUT_MS=15000

# Email Notification Dispatch (Optional: for automated report delivery to inbox)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_google_app_password
DEVELOPER_EMAIL=saikrishnabathina999@gmail.com
