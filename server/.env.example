# Server Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/cricket_laws_assistant

# Authentication
JWT_SECRET=cricket-laws-rag-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# LLM Provider (gemini | openai | mock)
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-flash

# Embedding Provider (gemini | openai | local)
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768
VECTOR_INDEX_NAME=cricket_vector_index

# File Storage
UPLOAD_STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
